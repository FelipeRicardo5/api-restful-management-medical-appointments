# Copy this file to .env for local development (docker-compose reads it automatically).

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

DATABASE_URL=postgres://postgres:postgres@db:5432/medical_appointments

CORS_ALLOWED_ORIGINS=http://localhost:3000

JWT_SIGNING_KEY=change-me-to-a-different-long-random-string
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7

DJANGO_LOG_LEVEL=INFO

# Only relevant behind HTTPS-terminating infra (ALB/production) - keep False for local http.
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Only enable behind a TLS-terminating proxy (ALB, Cloud Run, nginx).
USE_X_FORWARDED_PROTO=False
